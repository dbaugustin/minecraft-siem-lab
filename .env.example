# Copy to .env and fill in. .env is gitignored; never commit real values.

# --- Minecraft server ---
# Strong random password, e.g.: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
RCON_PASSWORD=change-me
MC_TYPE=VANILLA
MC_VERSION=LATEST
MC_MEMORY=2G
# Comma-separated Minecraft usernames
MC_WHITELIST=
MC_OPS=

# --- Dashboard ---
# Flask session signing key, e.g.: python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-me
DASHBOARD_ADMIN_USER=admin
# Argon2 hash of the admin password (not the password itself).
# The dashboard will ship a helper to generate this.
DASHBOARD_ADMIN_PASSWORD_HASH=
# Backups older than the newest N are deleted (scheduled backups, later milestone)
BACKUP_RETENTION=10
