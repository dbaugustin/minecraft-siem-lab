# Copy to .env and fill in. .env is gitignored; never commit real values.
# Per-world settings (version, memory, port, whitelist, RCON password...) are
# not configured here; they live in worlds/<name>/world.json and are edited
# from the dashboard.

# --- Dashboard ---
# Flask session signing key, 64 random hex characters. Generate one with
#   docker compose run --rm dashboard python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-me
DASHBOARD_ADMIN_USER=admin
# Argon2 hash of the admin password (not the password itself). Generate it with
#   docker compose run --rm dashboard python scripts/hash_password.py
# and paste it in single quotes, since it contains '$' characters:
#   DASHBOARD_ADMIN_PASSWORD_HASH='$argon2id$...'
DASHBOARD_ADMIN_PASSWORD_HASH=
# Running worlds are backed up automatically every N hours (0 turns it off).
# Stopped worlds are skipped, since their data can't change.
BACKUP_INTERVAL_HOURS=24
# Keep the newest N backups per world, manual and scheduled alike; older ones
# are deleted after each new backup. 0 keeps everything.
BACKUP_RETENTION=10
# Largest world .zip you can upload on a world's page, in MB.
WORLD_UPLOAD_MAX_MB=10240
# The "Wazuh SIEM" link in the dashboard's top bar. Empty hides it.
WAZUH_URL=https://localhost

# --- Defaults for new worlds (each world can override them) ---
# SPIGOT is built from source with BuildTools, so a new world's first start
# takes several minutes. Other types: VANILLA, PAPER, FABRIC, FORGE, PURPUR.
MC_DEFAULT_TYPE=SPIGOT
MC_DEFAULT_VERSION=LATEST
MC_DEFAULT_MEMORY=2G
# The first world gets this host port; new worlds take the next free one.
MC_BASE_PORT=25565
# Server image for every world. Spigot is built from source, which needs a JDK
# tag (the plain :latest tag is a JRE and the build fails).
# MC_IMAGE=itzg/minecraft-server:java25-jdk

# Absolute host path of ./worlds. Defaults to $PWD/worlds when you run
# `docker compose` from the repo root; set it if you run compose from elsewhere
# (for example via sudo or a systemd unit, where $PWD may differ).
# HOST_WORLDS_DIR=/home/david/minecraft-siem-lab/worlds
# Docker Desktop on Windows: $PWD isn't set for compose, so set this to the
# Windows path in the form the Docker VM sees it, for example
# HOST_WORLDS_DIR=/run/desktop/mnt/host/c/Users/david/minecraft-siem-lab/worlds
