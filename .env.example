# Copy to .env and fill in. .env is gitignored; never commit real values.
# Per-world settings (version, memory, port, whitelist, RCON password...) are
# not configured here; they live in worlds/<name>/world.json and are edited
# from the dashboard.

# --- Dashboard ---
# Flask session signing key, e.g.: python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-me
DASHBOARD_ADMIN_USER=admin
# Argon2 hash of the admin password (not the password itself).
# The dashboard will ship a helper to generate this.
DASHBOARD_ADMIN_PASSWORD_HASH=
# Backups older than the newest N per world are deleted (scheduled backups, later milestone)
BACKUP_RETENTION=10

# --- Defaults for new worlds (each world can override them) ---
# SPIGOT is built from source with BuildTools, so a new world's first start
# takes several minutes. Other types: VANILLA, PAPER, FABRIC, FORGE, PURPUR.
MC_DEFAULT_TYPE=SPIGOT
MC_DEFAULT_VERSION=LATEST
MC_DEFAULT_MEMORY=2G
# The first world gets this host port; new worlds take the next free one.
MC_BASE_PORT=25565

# Absolute host path of ./worlds. Defaults to $PWD/worlds when you run
# `docker compose` from the repo root; set it if you run compose from elsewhere
# (for example via sudo or a systemd unit, where $PWD may differ).
# HOST_WORLDS_DIR=/home/david/minecraft-siem-lab/worlds
