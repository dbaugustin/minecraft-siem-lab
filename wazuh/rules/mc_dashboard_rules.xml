<!--
  Rules for the management dashboard's audit log (JSON lines).

  No custom decoder is needed here: Wazuh's built-in "json" decoder already
  turns every key of the line into a field, so these rules match on fields
  directly. Expected line shape:

    {"timestamp": "2026-10-05T18:01:10+00:00", "app": "mc-dashboard",
     "event": "login_failure", "user": "david", "src_ip": "127.0.0.1",
     "reason": "bad_password"}

  Field and event names follow dashboard/mcdash/audit.py.

  Descriptions use $(user)$(dstuser): Wazuh 4.9 keeps the JSON key "user"
  as the field "user", while 4.14 stores it as "dstuser". One of the two is
  always empty, so the name shows up on either version.

  Rule IDs 100100-100199.
-->

<group name="mc_dashboard,">

  <!-- Base: anything the dashboard writes. Level 0 = decoded but no alert. -->
  <rule id="100100" level="0">
    <decoded_as>json</decoded_as>
    <field name="app">^mc-dashboard$</field>
    <description>Minecraft dashboard: audit event</description>
  </rule>

  <!-- ===== Authentication ===== -->

  <rule id="100101" level="3">
    <if_sid>100100</if_sid>
    <field name="event">^login_success$</field>
    <description>Minecraft dashboard: user $(user)$(dstuser) logged in</description>
    <group>authentication_success,</group>
  </rule>

  <rule id="100102" level="5">
    <if_sid>100100</if_sid>
    <field name="event">^login_failure$</field>
    <description>Minecraft dashboard: failed login for user $(user)$(dstuser) ($(reason))</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>authentication_failed,</group>
  </rule>

  <!-- 5 failures inside 2 minutes, whatever username was tried. -->
  <rule id="100103" level="10" frequency="5" timeframe="120">
    <if_matched_sid>100102</if_matched_sid>
    <description>Minecraft dashboard: possible brute force, 5 failed logins in 2 minutes</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>authentication_failures,</group>
  </rule>

  <!-- The dashboard's own lockout tripped. -->
  <rule id="100104" level="10">
    <if_sid>100100</if_sid>
    <field name="event">^account_locked$</field>
    <description>Minecraft dashboard: account $(user)$(dstuser) locked out after repeated failed logins</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>authentication_failures,</group>
  </rule>

  <!-- Someone kept trying while the account was already locked. -->
  <rule id="100106" level="8">
    <if_sid>100100</if_sid>
    <field name="event">^login_blocked$</field>
    <description>Minecraft dashboard: login attempt for locked account $(user)$(dstuser)</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>authentication_failures,</group>
  </rule>

  <!-- A form was posted without a valid CSRF token: a forged or replayed request. -->
  <rule id="100107" level="7">
    <if_sid>100100</if_sid>
    <field name="event">^csrf_failure$</field>
    <description>Minecraft dashboard: request rejected, missing or invalid CSRF token</description>
    <group>web_attack,</group>
  </rule>

  <rule id="100105" level="3">
    <if_sid>100100</if_sid>
    <field name="event">^logout$</field>
    <description>Minecraft dashboard: user $(user)$(dstuser) logged out</description>
  </rule>

  <!-- ===== Admin actions (audit trail) ===== -->

  <rule id="100110" level="5">
    <if_sid>100100</if_sid>
    <field name="event">^server_start$</field>
    <description>Minecraft dashboard: $(user)$(dstuser) started world $(world)</description>
    <group>admin_action,</group>
  </rule>

  <rule id="100111" level="7">
    <if_sid>100100</if_sid>
    <field name="event">^server_stop$</field>
    <description>Minecraft dashboard: $(user)$(dstuser) stopped world $(world)</description>
    <group>admin_action,</group>
  </rule>

  <rule id="100112" level="5">
    <if_sid>100100</if_sid>
    <field name="event">^server_restart$</field>
    <description>Minecraft dashboard: $(user)$(dstuser) restarted world $(world)</description>
    <group>admin_action,</group>
  </rule>

  <rule id="100113" level="3">
    <if_sid>100100</if_sid>
    <field name="event">^backup_created$</field>
    <description>Minecraft dashboard: backup of world $(world) created ($(target))</description>
    <group>admin_action,</group>
  </rule>

  <rule id="100114" level="8">
    <if_sid>100100</if_sid>
    <field name="event">^backup_failed$</field>
    <description>Minecraft dashboard: backup of world $(world) FAILED ($(reason))</description>
    <group>admin_action,</group>
  </rule>

  <!-- Retention (BACKUP_RETENTION) deleted an old backup. Scheduled backups
       and their pruning are logged with user "scheduler". -->
  <rule id="100125" level="3">
    <if_sid>100100</if_sid>
    <field name="event">^backup_pruned$</field>
    <description>Minecraft dashboard: old backup $(target) of world $(world) deleted by retention</description>
    <group>admin_action,</group>
  </rule>

  <rule id="100115" level="7">
    <if_sid>100100</if_sid>
    <field name="event">^whitelist_add$</field>
    <description>Minecraft dashboard: $(user)$(dstuser) added $(target) to the whitelist of world $(world)</description>
    <group>admin_action,</group>
  </rule>

  <rule id="100116" level="7">
    <if_sid>100100</if_sid>
    <field name="event">^whitelist_remove$</field>
    <description>Minecraft dashboard: $(user)$(dstuser) removed $(target) from the whitelist of world $(world)</description>
    <group>admin_action,</group>
  </rule>

  <rule id="100117" level="5">
    <if_sid>100100</if_sid>
    <field name="event">^world_settings_changed$</field>
    <description>Minecraft dashboard: $(user)$(dstuser) changed settings of world $(world)</description>
    <group>admin_action,</group>
  </rule>

  <!-- A new world is a new server container with its own game port. -->
  <rule id="100118" level="7">
    <if_sid>100100</if_sid>
    <field name="event">^world_created$</field>
    <description>Minecraft dashboard: $(user)$(dstuser) created world $(world) on port $(port)</description>
    <group>admin_action,</group>
  </rule>

  <!-- Destructive: the world's container is removed and its folder moved to
       worlds/.deleted/ ($(target) is the folder name there). -->
  <rule id="100119" level="10">
    <if_sid>100100</if_sid>
    <field name="event">^world_deleted$</field>
    <description>Minecraft dashboard: $(user)$(dstuser) DELETED world $(world) (moved to worlds/.deleted/$(target))</description>
    <group>admin_action,</group>
  </rule>

  <!-- ===== Operators, console and world uploads ===== -->

  <!-- Operator is full in-game admin: worth a look every time. -->
  <rule id="100126" level="8">
    <if_sid>100100</if_sid>
    <field name="event">^op_granted$</field>
    <description>Minecraft dashboard: $(user) made $(target) an operator of world $(world)</description>
    <mitre>
      <id>T1098</id>
    </mitre>
    <group>admin_action,</group>
  </rule>

  <rule id="100127" level="5">
    <if_sid>100100</if_sid>
    <field name="event">^op_revoked$</field>
    <description>Minecraft dashboard: $(user) removed operator from $(target) on world $(world)</description>
    <group>admin_action,</group>
  </rule>

  <!-- Any command sent through the dashboard's console; $(target) is the command. -->
  <rule id="100128" level="5">
    <if_sid>100100</if_sid>
    <field name="event">^console_command$</field>
    <description>Minecraft dashboard: $(user) ran console command on world $(world): $(target)</description>
    <group>admin_action,</group>
  </rule>

  <!-- Console commands that change who can get in or who is in charge. -->
  <rule id="100129" level="8">
    <if_sid>100128</if_sid>
    <field name="target" type="pcre2">(?i)^(?:op|deop|whitelist|ban|ban-ip|pardon|pardon-ip)(?:\s|$)</field>
    <description>Minecraft dashboard: $(user) changed access on world $(world) from the console: $(target)</description>
    <mitre>
      <id>T1098</id>
    </mitre>
    <group>admin_action,</group>
  </rule>

  <!-- The world's files were replaced with an uploaded .zip. The old world
       was moved to worlds/.deleted/ ($(moved_aside)). -->
  <rule id="100130" level="8">
    <if_sid>100100</if_sid>
    <field name="event">^world_uploaded$</field>
    <description>Minecraft dashboard: $(user) replaced world $(world) with upload $(target)</description>
    <group>admin_action,</group>
  </rule>

  <!-- A rejected upload: wrong file, too large, or a zip trying to write
       outside the world folder (zip slip) or unpack far too much (zip bomb). -->
  <rule id="100131" level="7">
    <if_sid>100100</if_sid>
    <field name="event">^world_upload_rejected$</field>
    <description>Minecraft dashboard: world upload to $(world) rejected ($(reason))</description>
    <group>admin_action,</group>
  </rule>

  <rule id="100132" level="10">
    <if_sid>100131</if_sid>
    <field name="reason" type="pcre2">outside its folder|absolute path|symlink</field>
    <description>Minecraft dashboard: upload to world $(world) tried to write outside the world folder ($(target))</description>
    <mitre>
      <id>T1105</id>
    </mitre>
    <group>web_attack,</group>
  </rule>

  <!-- ===== Access model check ===== -->

  <!--
    The dashboard is published on 127.0.0.1 only, so every request should
    come from the server box itself. Because the dashboard runs in Docker,
    a request from the host's loopback reaches Flask from the Docker bridge
    gateway (an address in 172.16.0.0/12), so that range counts as local
    along with 127.0.0.1 and ::1.

    If the port were ever published on 0.0.0.0, a request from another
    machine keeps its real source address through Docker's NAT, and this
    rule fires. Blind spot: a LAN that itself uses 172.16.0.0/12 addresses.
  -->
  <rule id="100120" level="12">
    <if_sid>100101, 100102, 100106</if_sid>
    <field name="src_ip" type="pcre2" negate="yes">^(?:127\.|::1$|::ffff:127\.|172\.(?:1[6-9]|2\d|3[01])\.)</field>
    <description>Minecraft dashboard: login attempt from non-localhost address $(src_ip), dashboard may be exposed</description>
    <mitre>
      <id>T1133</id>
    </mitre>
    <group>policy_violation,</group>
  </rule>

</group>
