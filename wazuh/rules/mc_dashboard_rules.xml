<!--
  Rules for the management dashboard's audit log (JSON lines).

  No custom decoder is needed here: Wazuh's built-in "json" decoder already
  turns every key of the line into a field, so these rules match on fields
  directly. Expected line shape:

    {"timestamp": "...", "app": "mc-dashboard", "event": "login_failed",
     "user": "david", "src_ip": "127.0.0.1", "outcome": "failure",
     "target": "...", "detail": "..."}

  Rule IDs 100100-100199.
-->

<group name="mc_dashboard,">

  <!-- Base: anything the dashboard writes. Level 0 = decoded but no alert. -->
  <rule id="100100" level="0">
    <decoded_as>json</decoded_as>
    <field name="app">^mc-dashboard$</field>
    <description>Minecraft dashboard: audit event</description>
  </rule>

  <!-- ===== Authentication ===== -->

  <rule id="100101" level="3">
    <if_sid>100100</if_sid>
    <field name="event">^login_success$</field>
    <description>Minecraft dashboard: user $(user) logged in</description>
    <group>authentication_success,</group>
  </rule>

  <rule id="100102" level="5">
    <if_sid>100100</if_sid>
    <field name="event">^login_failed$</field>
    <description>Minecraft dashboard: failed login for user $(user)</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>authentication_failed,</group>
  </rule>

  <!-- 5 failures inside 2 minutes, whatever username was tried. -->
  <rule id="100103" level="10" frequency="5" timeframe="120">
    <if_matched_sid>100102</if_matched_sid>
    <description>Minecraft dashboard: possible brute force, 5 failed logins in 2 minutes</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>authentication_failures,</group>
  </rule>

  <!-- The dashboard's own lockout tripped. -->
  <rule id="100104" level="10">
    <if_sid>100100</if_sid>
    <field name="event">^login_locked$</field>
    <description>Minecraft dashboard: account $(user) locked out after repeated failed logins</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>authentication_failures,</group>
  </rule>

  <rule id="100105" level="3">
    <if_sid>100100</if_sid>
    <field name="event">^logout$</field>
    <description>Minecraft dashboard: user $(user) logged out</description>
  </rule>

  <!-- ===== Admin actions (audit trail) ===== -->

  <rule id="100110" level="5">
    <if_sid>100100</if_sid>
    <field name="event">^server_start$</field>
    <description>Minecraft dashboard: $(user) started the server</description>
    <group>admin_action,</group>
  </rule>

  <rule id="100111" level="7">
    <if_sid>100100</if_sid>
    <field name="event">^server_stop$</field>
    <description>Minecraft dashboard: $(user) stopped the server</description>
    <group>admin_action,</group>
  </rule>

  <rule id="100112" level="5">
    <if_sid>100100</if_sid>
    <field name="event">^server_restart$</field>
    <description>Minecraft dashboard: $(user) restarted the server</description>
    <group>admin_action,</group>
  </rule>

  <rule id="100113" level="3">
    <if_sid>100100</if_sid>
    <field name="event">^backup_created$</field>
    <description>Minecraft dashboard: world backup created ($(target))</description>
    <group>admin_action,</group>
  </rule>

  <rule id="100114" level="8">
    <if_sid>100100</if_sid>
    <field name="event">^backup_failed$</field>
    <description>Minecraft dashboard: world backup FAILED</description>
    <group>admin_action,</group>
  </rule>

  <rule id="100115" level="7">
    <if_sid>100100</if_sid>
    <field name="event">^whitelist_add$</field>
    <description>Minecraft dashboard: $(user) added $(target) to the whitelist</description>
    <group>admin_action,</group>
  </rule>

  <rule id="100116" level="7">
    <if_sid>100100</if_sid>
    <field name="event">^whitelist_remove$</field>
    <description>Minecraft dashboard: $(user) removed $(target) from the whitelist</description>
    <group>admin_action,</group>
  </rule>

  <!-- ===== Access model check ===== -->

  <!--
    The dashboard is bound to 127.0.0.1, so every request should come from
    loopback. A login event from any other address means the bind address or
    firewall changed and the dashboard is reachable from the network.
  -->
  <rule id="100120" level="12">
    <if_sid>100101, 100102</if_sid>
    <field name="src_ip" negate="yes">^127\.0\.0\.1$|^::1$</field>
    <description>Minecraft dashboard: login attempt from non-localhost address $(src_ip), dashboard may be exposed</description>
    <mitre>
      <id>T1133</id>
    </mitre>
    <group>policy_violation,</group>
  </rule>

</group>
