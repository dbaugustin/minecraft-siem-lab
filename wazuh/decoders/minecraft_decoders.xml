<!--
  Minecraft server log decoders (logs/latest.log).

  Handles both header styles:
    Vanilla / Fabric:  [14:50:01] [Server thread/INFO]: Steve joined the game
    Paper / Spigot:    [14:50:01 INFO]: Steve joined the game

  The agent prefixes every line with the file it came from (see out_format
  in agent/localfile.conf), which is how the world name gets into the event:

    /opt/minecraft-siem-lab/worlds/survival/data/logs/latest.log: [14:50:01] [Server thread/INFO]: ...

  The prefix is optional, so raw lines pasted into wazuh-logtest still decode
  (just without a world field).

  The parent decoder only recognises "this is a Minecraft log line".
  The child decoders all share the name "minecraft-fields" (Wazuh "sibling
  decoders"): every one of them is tried, and each adds whatever fields its
  regex captures. Rules then match on the message text and these fields.

  Fields produced:
    world      world name, from the worlds/<world>/data/logs/ path
    level      INFO / WARN / ERROR / FATAL
    player     player name the line is about
    srcip      client address as the server sees it (behind playit.gg this is
               the tunnel endpoint, not the player's real IP)
    srcport    client source port
    actor      who ran an admin command (e.g. "Rcon" for the dashboard)
    mc_version server version from the startup banner
    crash_report path of a crash report file
-->

<decoder name="minecraft">
  <prematch type="pcre2">^(?:\S*/worlds/[^/]+/data/logs/[^:]+: )?\[\d\d:\d\d:\d\d(?:\] \[[^\]]+/| )(?:INFO|WARN|ERROR|FATAL)\]: </prematch>
</decoder>

<!-- World name, from the path prefix. -->
<decoder name="minecraft-fields">
  <parent>minecraft</parent>
  <regex type="pcre2">^\S*/worlds/([^/]+)/data/logs/[^:]+: \[</regex>
  <order>world</order>
</decoder>

<!-- Log level, from the header. -->
<decoder name="minecraft-fields">
  <parent>minecraft</parent>
  <regex type="pcre2">\[\d\d:\d\d:\d\d(?:\] \[[^\]]+/| )(INFO|WARN|ERROR|FATAL)\]: </regex>
  <order>level</order>
</decoder>

<!-- Steve[/1.2.3.4:51234] logged in with entity id 123 at (...) -->
<decoder name="minecraft-fields">
  <parent>minecraft</parent>
  <regex type="pcre2">\]: (\w+)\[/([^\]]+):(\d+)\] logged in with entity id</regex>
  <order>player, srcip, srcport</order>
</decoder>

<!-- Steve joined the game / Steve left the game -->
<decoder name="minecraft-fields">
  <parent>minecraft</parent>
  <regex type="pcre2">\]: (\w+) (?:joined|left) the game$</regex>
  <order>player</order>
</decoder>

<!--
  Rejected connections. Covers both wordings used by modern servers:
    Disconnecting Griefer (/1.2.3.4:51234): You are not white-listed on this server!
    Griefer (/1.2.3.4:51234) lost connection: You are not white-listed on this server!
-->
<decoder name="minecraft-fields">
  <parent>minecraft</parent>
  <regex type="pcre2">\]: (?:Disconnecting )?(\w+) \(/([^)]+):(\d+)\)(?: lost connection)?: </regex>
  <order>player, srcip, srcport</order>
</decoder>

<!-- Admin commands echoed to the log, e.g. [Rcon: Added Steve to the whitelist].
     Minecraft 26.x prefixes the echo with "System chat: ". -->
<decoder name="minecraft-fields">
  <parent>minecraft</parent>
  <regex type="pcre2">\]: (?:System chat: )?\[(\w+): (?:Added|Removed|Made) (\w+) </regex>
  <order>actor, player</order>
</decoder>

<!-- Starting minecraft server version 1.21.1 -->
<decoder name="minecraft-fields">
  <parent>minecraft</parent>
  <regex type="pcre2">\]: Starting minecraft server version (\S+)</regex>
  <order>mc_version</order>
</decoder>

<!-- This crash report has been saved to: /data/./crash-reports/crash-....txt -->
<decoder name="minecraft-fields">
  <parent>minecraft</parent>
  <regex type="pcre2">crash report has been saved to: (\S+)</regex>
  <order>crash_report</order>
</decoder>
